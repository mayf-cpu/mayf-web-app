{
  "name": "mayf",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "previews": {},
  "main": "worker.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "define": {
    "process.env.NODE_ENV": "\"production\""
  }
}
