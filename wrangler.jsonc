{
  "name": "mayf",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "r2_buckets": [
    {
      "binding": "MAYF_PDF_BUCKET",
      "bucket_name": "mayf-study-materials"
    }
  ],
  "main": "worker.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "define": {
    "process.env.NODE_ENV": "\"production\""
  }
}
