{
  "name": "mayf-staging",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MAYF_PDF_BUCKET",
      "bucket_name": "mayf-staging-files"
    }
  ],
  "define": {
    "process.env.NODE_ENV": "\"production\""
  },
  "vars": {
    "APP_ENV": "staging",
    "MAYF_ENABLE_CHECKOUT": "false",
    "MAYF_ENABLE_ADMIN_REFUNDS": "false",
    "MAYF_ENABLE_COUPON_CHECKOUT": "false",
    "MAYF_ENABLE_PAYMENT_SIMULATION": "false"
  }
}
