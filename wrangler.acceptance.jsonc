{
  "name": "staging-acceptance-mayf",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MAYF_PDF_BUCKET",
      "bucket_name": "mayf-staging-materials"
    }
  ],
  "define": {
    "process.env.NODE_ENV": "\"production\""
  },
  "vars": {
    "APP_ENV": "staging",
    "PUBLIC_APP_URL": "https://staging-acceptance-mayf.sachinagrawal16.workers.dev",
    "MAYF_ENABLE_CHECKOUT": "true",
    "MAYF_ENABLE_ADMIN_REFUNDS": "true",
    "MAYF_ENABLE_COUPON_CHECKOUT": "false",
    "MAYF_ENABLE_PAYMENT_SIMULATION": "false",
    "MAYF_ALLOW_SHARED_DEVELOPMENT_FIREBASE": "true"
  }
}
