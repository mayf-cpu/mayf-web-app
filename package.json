    "firebase-admin": "^14.5.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.546.0",
    "mathlive": "^0.111.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
