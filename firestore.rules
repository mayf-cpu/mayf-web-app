rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && (
        request.auth.token.get('role', '') in ['admin', 'superAdmin'] ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('superAdmin', false) == true
      );
    }
    function text(value, max) { return value is string && value.size() <= max; }
    function optionalText(data, key, max) { return !(key in data) || text(data[key], max); }
    function profile(data) {
      return text(data.uid, 128) && data.uid == request.auth.uid
        && text(data.displayName, 120) && text(data.email, 254)
        && data.email == request.auth.token.get('email', '')
        && data.studentClass in ['Class 5', 'Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10']
        && data.board in ['CBSE', 'ICSE']
        && optionalText(data, 'photoURL', 2048) && optionalText(data, 'phoneNumber', 32)
        && optionalText(data, 'lastActiveDate', 32) && optionalText(data, 'lastLoginAt', 40)
        && optionalText(data, 'createdAt', 40) && optionalText(data, 'updatedAt', 40)
        && (!('streakDays' in data) || data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 36600);
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid) && profile(request.resource.data)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'studentClass', 'board', 'phoneNumber', 'streakDays', 'lastActiveDate', 'lastLoginAt', 'createdAt', 'updatedAt']);
      allow update: if owner(uid) && profile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'studentClass', 'board', 'phoneNumber', 'streakDays', 'lastActiveDate', 'lastLoginAt', 'updatedAt']);
      allow delete: if false;
    }
    // Raw CMS documents contain private attachment/source metadata. Public reads
    // go through the Worker projection; all mutations use its validated APIs.
    match /contentItems/{id} { allow read: if admin(); allow write: if false; }
    match /categories/{id} { allow read: if true; allow write: if false; }
    // Even administrator browsers cannot manufacture payments or bypass atomic
    // order/coupon/entitlement writes. The service account is authorized by IAM.
    match /orders/{id} { allow read: if owner(resource.data.userId) || admin(); allow write: if false; }
    match /payments/{id} { allow read: if owner(resource.data.userId) || admin(); allow write: if false; }
    match /entitlements/{id} { allow read: if owner(resource.data.userId) || admin(); allow write: if false; }
    match /annualPasses/{id} { allow read: if owner(resource.data.userId) || admin(); allow write: if false; }
    match /aiTeacherSessions/{id} {
      allow read: if owner(resource.data.userId) || admin();
      // Generation, metrics and feedback are verified by authenticated Worker routes.
      allow write: if false;
    }
    match /savedItems/{id} {
      allow read: if owner(resource.data.userId);
      allow create: if signedIn() && owner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['id', 'userId', 'contentItemId', 'itemType', 'title', 'slug', 'classLevel', 'createdAt'])
        && request.resource.data.id == id && text(id, 200)
        && text(request.resource.data.contentItemId, 200)
        && request.resource.data.itemType in ['formula', 'chapter', 'content']
        && text(request.resource.data.title, 200) && text(request.resource.data.slug, 200)
        && text(request.resource.data.createdAt, 40) && optionalText(request.resource.data, 'classLevel', 20);
      allow update: if false;
      allow delete: if owner(resource.data.userId);
    }
    function activityMetadata(data) {
      return data is map && data.keys().hasOnly(['category', 'classLevel', 'topic', 'plan', 'amount', 'currency', 'gateway', 'transactionId', 'contentType', 'accessType', 'hasImage', 'studentClass', 'questionType', 'orderId', 'provider', 'fileSize'])
        && optionalText(data, 'category', 120) && optionalText(data, 'classLevel', 20)
        && optionalText(data, 'topic', 200) && optionalText(data, 'plan', 120)
        && optionalText(data, 'currency', 8) && optionalText(data, 'gateway', 32)
        && optionalText(data, 'transactionId', 200) && optionalText(data, 'contentType', 32)
        && optionalText(data, 'accessType', 32) && optionalText(data, 'studentClass', 20)
        && optionalText(data, 'questionType', 32) && optionalText(data, 'orderId', 200)
        && optionalText(data, 'provider', 32) && optionalText(data, 'fileSize', 40)
        && (!('hasImage' in data) || data.hasImage is bool)
        && (!('amount' in data) || data.amount is number && data.amount >= 0 && data.amount <= 10000000);
    }
    match /activityLogs/{id} {
      allow read: if owner(resource.data.userId) || admin();
      // Activity is explicitly client-reported and never grants purchased access.
      allow create: if signedIn() && owner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['id', 'userId', 'eventType', 'title', 'targetId', 'targetSlug', 'targetType', 'metadata', 'createdAt'])
        && request.resource.data.id == id && text(id, 200)
        && request.resource.data.eventType in ['content_view', 'download', 'save', 'unsave', 'ai_question', 'purchase', 'course_open', 'formula_view', 'login']
        && text(request.resource.data.title, 500) && text(request.resource.data.createdAt, 40)
        && optionalText(request.resource.data, 'targetId', 200) && optionalText(request.resource.data, 'targetSlug', 200)
        && optionalText(request.resource.data, 'targetType', 32)
        && (!('metadata' in request.resource.data) || activityMetadata(request.resource.data.metadata));
      allow update: if false;
      allow delete: if owner(resource.data.userId);
    }
    match /notifications/{id} {
      allow read: if owner(resource.data.userId);
      allow update: if owner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create: if false;
      allow delete: if owner(resource.data.userId);
    }
    // All settings, offers, imports, analytics, audit, download tickets, quota,
    // encryption payloads and revision markers are accessed through Worker APIs.
    match /{document=**} { allow read, write: if false; }
  }
}
